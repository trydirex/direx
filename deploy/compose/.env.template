# Direx on a server. install.sh copies this to .env once and fills every FILL; it never
# overwrites an existing .env. Never commit .env. Secrets typed by a person (the SMTP URL, model
# keys, sign-in client secrets) go in the vault, not here:
#   docker compose exec direx bun apps/api/src/secrets.ts set <name>   (value on stdin)

# The image version to run, a release tag such as v0.1.0.
DIREX_VERSION=FILL

# The address people open; sign-in, invite and connect links point here.
DIREX_BASE_URL=FILL

# The From address of sign-in and invite mail.
DIREX_MAIL_FROM=FILL

# Database passwords and URLs, generated by install.sh. The owner runs migrations; the app role
# is what Direx uses for everything else.
POSTGRES_PASSWORD=FILL
DIREX_DB_OWNER_URL=FILL
DIREX_DB_APP_URL=FILL

# A public domain served by Caddy with automatic HTTPS (install.sh --public). Empty for a private
# server behind Tailscale or your own proxy.
DIREX_DOMAIN=
COMPOSE_PROFILES=

# Nightly backups by backup.sh (README.md, "Backups"). The rclone remote and
# folder the encrypted dumps go to, such as b2:direx-backups, and the age public key they are
# encrypted to (age1...). Its identity, the private half, never goes on this server.
DIREX_BACKUP_REMOTE=
DIREX_BACKUP_AGE_RECIPIENT=

# A self-hosted Direx. Leave as is.
DIREX_DEPLOYMENT=self_host

# A reverse proxy on this machine (Caddy, Tailscale) reaches Direx from these addresses. Sign-in
# is rate limited per client address, so without this everyone behind the proxy shares one limit.
DIREX_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
