{
  "name": "direx",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "server-admin": "bun scripts/server-admin.ts",
    "plugin": "bun scripts/plugin.ts",
    "dev": "bun run --parallel --filter @direx/api --filter @direx/web dev",
    "start": "cd apps/api && bun run start",
    "build": "bun run --filter @direx/api build && bun run --filter @direx/web build",
    "ci": "bun run lint && bun run check:web-rules && bun run check:deps && bun run check:migrations && bun run check:license && bun run check:package && bun run check:plugin-loading && bun run eval:check && bun run typecheck && bun run build && bun run test:coverage",
    "db:generate": "cd packages/db && bunx drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "test": "ICU_TIMEZONE_FILES_DIR=deploy/icu-tz bun --bun vitest run",
    "test:coverage": "ICU_TIMEZONE_FILES_DIR=deploy/icu-tz bun --bun vitest run --coverage",
    "lint": "eslint .",
    "check:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:migrations": "bun scripts/check-migrations.ts",
    "check:license": "bun scripts/check-license.ts",
    "check:package": "bun scripts/check-package.ts",
    "eval": "bun scripts/eval.ts",
    "eval:check": "bun scripts/eval-check.ts",
    "eval:impact": "bun scripts/eval-impact.ts",
    "check:plugin-loading": "bun scripts/check-plugin-loading.ts",
    "check:floor": "bun scripts/check-floor.ts",
    "check:web-rules": "bun scripts/check-web-rules.ts",
    "check:coverage": "bun scripts/check-coverage.ts",
    "adr:rules": "bun scripts/adr-rules.ts",
    "check:web": "bun scripts/check-web.ts",
    "check:security": "bun scripts/check-security.ts",
    "sdk:pack": "bun scripts/sdk-pack.ts",
    "check:task": "bun run check:floor && bun run check:license && bun run check:web-rules && bun run lint && bun run typecheck && bun run test:coverage && bun run check:coverage",
    "check:full": "bun run ci && bun run check:coverage && bun run check:floor && bun run check:web && bun run check:security",
    "gen": "bun apps/api/scripts/gen-openapi.ts && bun run --filter @direx/web gen",
    "typecheck": "bun run gen && (tsc -p . & r=$!; NODE_OPTIONS=--max-old-space-size=3072 tsc -p apps/api & a=$!; tsc -p apps/web & w=$!; wait $r && wait $a && wait $w)"
  },
  "devDependencies": {
    "@direx/db": "workspace:*",
    "@direx/extensions": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "drizzle-orm": "0.45.4",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "mailauth": "8.0.6",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
