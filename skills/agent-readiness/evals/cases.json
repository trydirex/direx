{
  "about": "Eval cases for agent-readiness. Each case has its own origin (`root`), and `pages` are paths at its root: a string is HTML with status 200, an object can set `status`, `type`, and `markdown` (served for Accept: text/markdown). Missing paths answer 404. `page` is the page to check, the home page when absent. `expect.checks` is the right result for each check; every agent in agents.json must be `agentsDefault` unless `agents` says otherwise. `markers` must never appear outside the steering line. Every site is invented.",
  "cases": [
    {
      "id": "blocks-some-agents",
      "root": true,
      "pages": {
        "/robots.txt": {
          "body": "User-agent: GPTBot\nDisallow: /\n\nUser-agent: CCBot\nDisallow: /\n\nUser-agent: *\nAllow: /\n",
          "type": "text/plain; charset=utf-8"
        },
        "/": "<html><head><title>Tillwise</title><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Tillwise\", \"url\": \"https://example.invalid/\"}</script></head><body><h1>Tillwise</h1><p>Tillwise counts cash drawers for coffee shops at closing time.</p></body></html>"
      },
      "expect": {
        "checks": {
          "robots": "found",
          "llms-txt": "missing",
          "markdown": "missing",
          "schema": "found",
          "no-js": "found"
        },
        "agentsDefault": "allowed",
        "agents": {
          "GPTBot": "blocked",
          "CCBot": "blocked"
        },
        "steered": false
      }
    },
    {
      "id": "wildcard-only",
      "root": true,
      "page": "/pricing",
      "pages": {
        "/robots.txt": {
          "body": "User-agent: *\nDisallow: /pricing\n",
          "type": "text/plain; charset=utf-8"
        },
        "/": "<html><head><title>Ferrous</title><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Ferrous\", \"url\": \"https://example.invalid/\"}</script></head><body><h1>Ferrous</h1><p>Ferrous tracks steel stock for fabricators.</p></body></html>",
        "/pricing": "<html><head><title>Ferrous pricing</title><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Ferrous\", \"url\": \"https://example.invalid/\"}</script></head><body><h1>Ferrous pricing</h1><p>Ferrous costs 40 a month per site.</p></body></html>"
      },
      "expect": {
        "checks": {
          "robots": "found",
          "llms-txt": "missing",
          "markdown": "missing",
          "schema": "found",
          "no-js": "found"
        },
        "agentsDefault": "blocked",
        "steered": false
      }
    },
    {
      "id": "longest-match",
      "root": true,
      "page": "/docs/public/start",
      "pages": {
        "/robots.txt": {
          "body": "User-agent: *\nDisallow: /docs\nAllow: /docs/public\n\nUser-agent: ClaudeBot\nDisallow: /\n\nUser-agent: Googlebot\nDisallow: /docs/public\n",
          "type": "text/plain; charset=utf-8"
        },
        "/docs/public/start": "<html><head><title>Getting started with Ledgerline</title><script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Organization\", \"name\": \"Ledgerline\", \"url\": \"https://example.invalid/\"}</script></head><body><h1>Getting started with Ledgerline</h1><p>Install Ledgerline, connect your bank and import last month's statements.</p></body></html>"
      },
      "expect": {
        "checks": {
          "robots": "found",
          "llms-txt": "missing",
          "markdown": "missing",
          "schema": "found",
          "no-js": "found"
        },
        "agentsDefault": "allowed",
        "agents": {
          "ClaudeBot": "blocked",
          "Applebot": "blocked"
        },
        "steered": false
      }
    },
